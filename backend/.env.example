# Postgres connection string in production (Render provides this automatically
# when you attach a database). Falls back to local SQLite if unset.
DATABASE_URL=

# Secret used to sign JWTs — set a long random value in production.
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call this API (your frontend URL).
FRONTEND_ORIGIN=http://localhost:5173
